<UserControl x:Class="ToolSet.Views.ProjectHelper.ExportConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- 「配置导出」卡片 -->
    <Border Style="{StaticResource SectionCard}"
            HorizontalAlignment="Stretch"
            Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource CardTitleText}" />

            <Border Height="1"
                    Background="{StaticResource LineBrush}"
                    Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="96" />
                    <ColumnDefinition Width="*" MaxWidth="420" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Excel配置目录"
                           Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Style="{StaticResource AppTextBox}"
                         Text="{Binding ExcelConfigDir, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="浏览"
                        Style="{StaticResource ActionButton}"
                        MinWidth="64"
                        Margin="8,0,0,8"
                        Command="{Binding BrowseExcelConfigDirCommand}" />

                <TextBlock Grid.Row="1"
                           Text="前端生成目录"
                           Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Style="{StaticResource AppTextBox}"
                         Text="{Binding FrontendOutputDir, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Content="浏览"
                        Style="{StaticResource ActionButton}"
                        MinWidth="64"
                        Margin="8,0,0,8"
                        Command="{Binding BrowseFrontendOutputDirCommand}" />

                <TextBlock Grid.Row="2"
                           Text="后端生成目录"
                           Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Style="{StaticResource AppTextBox}"
                         Text="{Binding BackendOutputDir, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="2"
                        Grid.Column="2"
                        Content="浏览"
                        Style="{StaticResource ActionButton}"
                        MinWidth="64"
                        Margin="8,0,0,8"
                        Command="{Binding BrowseBackendOutputDirCommand}" />
            </Grid>

            <!-- 配置文件下拉框 + 导出范围按钮（按钮功能待定） -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="96" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="配置文件"
                           Style="{StaticResource FieldLabelText}" />
                <ComboBox Grid.Column="1"
                          Style="{StaticResource AppComboBox}"
                          Width="360"
                          Margin="0,0,0,8"
                          ItemsSource="{Binding ExcelConfigFiles}"
                          SelectedItem="{Binding SelectedExcelConfigFile}" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="8,0,0,8">
                    <Button Content="前端"
                            Style="{StaticResource ActionButton}"
                            MinWidth="56"
                            Padding="10,0" />
                    <Button Content="后端"
                            Style="{StaticResource ActionButton}"
                            MinWidth="56"
                            Padding="10,0"
                            Margin="6,0,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0"
                        Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}">
                <Button Content="取消"
                        Style="{StaticResource ActionButton}"
                        MinWidth="76"
                        Margin="0,0,8,0"
                        Command="{Binding CancelEditCommand}" />
                <Button Content="确认"
                        Style="{StaticResource ActionButton}"
                        MinWidth="76"
                        Command="{Binding ConfirmEditCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
