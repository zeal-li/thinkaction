<Window x:Class="ToolSet.Views.ProjectManagement.CreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建项目"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBackgroundBrush}">

    <Border Style="{StaticResource SectionCard}" Margin="10">
        <StackPanel>
            <!-- 每行一个配置项：左边标签，右边输入框 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="项目名称"
                           Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Column="1"
                         x:Name="ProjectNameBox"
                         Style="{StaticResource AppTextBox}"
                         Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1"
                           Text="检出根目录"
                           Style="{StaticResource FieldLabelText}" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Style="{StaticResource AppTextBox}"
                         Text="{Binding CheckoutRootDir, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="取消"
                        Style="{StaticResource ActionButton}"
                        MinWidth="76"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Content="创建"
                        Style="{StaticResource ActionButton}"
                        MinWidth="76"
                        IsDefault="True"
                        IsEnabled="{Binding HasProjectName}"
                        Click="Create_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
