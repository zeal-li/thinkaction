<Window x:Class="ToolSet.Views.ProjectManagement.CreateProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建项目"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBackgroundBrush}">

    <Border Style="{StaticResource SectionCard}" Margin="10">
        <StackPanel>
            <!-- 项目名称，后续字段继续往下排 -->
            <TextBlock Text="项目名称" Style="{StaticResource FieldLabelText}" />
            <TextBox x:Name="ProjectNameBox"
                     Style="{StaticResource AppTextBox}"
                     Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="取消"
                        Style="{StaticResource ActionButton}"
                        MinWidth="76"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Content="创建"
                        Style="{StaticResource ActionButton}"
                        MinWidth="76"
                        IsDefault="True"
                        IsEnabled="{Binding HasProjectName}"
                        Click="Create_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
