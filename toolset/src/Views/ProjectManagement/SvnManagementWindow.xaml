<Window x:Class="ToolSet.Views.ProjectManagement.SvnManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Svn 版本管理"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <!-- 只读信息值：过长时省略号截断，完整内容放 ToolTip -->
        <Style x:Key="InfoValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource SectionCard}" Margin="10">
        <StackPanel>

            <!-- ===== 卡片头：项目名 ===== -->
            <TextBlock Text="{Binding Name}"
                       Style="{StaticResource CardTitleText}"
                       Margin="0" />

            <Border Height="1"
                    Background="{StaticResource LineBrush}"
                    Margin="0,10,0,10" />

            <!-- ===== 项目信息（只读） ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="检出根目录"
                           Style="{StaticResource FieldLabelText}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CheckoutRootDir}"
                           Style="{StaticResource InfoValueText}" />

                <TextBlock Grid.Row="1"
                           Text="Svn 地址"
                           Style="{StaticResource FieldLabelText}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Svn}"
                           Style="{StaticResource InfoValueText}" />
            </Grid>

            <Border Height="1"
                    Background="{StaticResource LineBrush}"
                    Margin="0,2,0,10" />

            <!-- ===== svn 操作 ===== -->
            <TextBlock Text="Svn 操作"
                       Style="{StaticResource SectionTitleText}" />

            <UniformGrid Rows="1" Columns="5">
                <Button Content="Checkout"
                        Style="{StaticResource ActionButton}"
                        MinWidth="0"
                        Height="34"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Command="{Binding SvnCheckoutCommand}" />
                <Button Content="Update"
                        Style="{StaticResource ActionButton}"
                        MinWidth="0"
                        Height="34"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Command="{Binding SvnUpdateCommand}" />
                <Button Content="Commit"
                        Style="{StaticResource ActionButton}"
                        MinWidth="0"
                        Height="34"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Command="{Binding SvnCommitCommand}" />
                <Button Content="Cleanup"
                        Style="{StaticResource ActionButton}"
                        MinWidth="0"
                        Height="34"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Command="{Binding SvnCleanupCommand}" />
                <Button Content="Log"
                        Style="{StaticResource ActionButton}"
                        MinWidth="0"
                        Height="34"
                        FontSize="12"
                        Command="{Binding SvnShowLogCommand}" />
            </UniformGrid>

            <TextBlock Text="操作会调起 TortoiseSVN 界面完成，结果由 TortoiseSVN 自己提示。"
                       Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />

            <!-- ===== 底部 ===== -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="关闭"
                        Style="{StaticResource ActionButton}"
                        MinWidth="76"
                        IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
