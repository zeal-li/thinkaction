<Window x:Class="ToolSet.Views.ProjectManagement.SvnManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Svn 版本管理"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <!-- 只读信息值：过长时省略号截断，完整内容放 ToolTip -->
        <Style x:Key="InfoValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource SectionCard}" Margin="10">
        <StackPanel>

            <!-- ===== 卡片头：项目名 + 检出 ===== -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{Binding ProjectName}"
                           Style="{StaticResource CardTitleText}"
                           VerticalAlignment="Center"
                           Margin="0" />
                <Button Content="检出"
                        Style="{StaticResource ActionButton}"
                        Height="26"
                        MinWidth="60"
                        Padding="10,0"
                        FontSize="12"
                        Margin="10,0,0,0"
                        Command="{Binding CheckoutCommand}" />
            </StackPanel>

            <!-- ===== 项目信息（只读） ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="检出根目录"
                           Style="{StaticResource FieldLabelText}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CheckoutRootDir}"
                           Style="{StaticResource InfoValueText}" />

                <TextBlock Grid.Row="1"
                           Text="Svn 地址"
                           Style="{StaticResource FieldLabelText}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Svn}"
                           Style="{StaticResource InfoValueText}" />
            </Grid>

            <Border Height="1"
                    Background="{StaticResource LineBrush}"
                    Margin="0,2,0,10" />

            <!-- ===== svn 操作 ===== -->
            <TextBlock Text="Svn 操作"
                       Style="{StaticResource SectionTitleText}" />

            <UniformGrid Rows="1" Columns="4">
                <Button Content="更新"
                        Style="{StaticResource ActionButton}"
                        MinWidth="0"
                        Height="34"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Command="{Binding UpdateCommand}" />
                <Button Content="提交"
                        Style="{StaticResource ActionButton}"
                        MinWidth="0"
                        Height="34"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Command="{Binding CommitCommand}" />
                <Button Content="清理"
                        Style="{StaticResource ActionButton}"
                        MinWidth="0"
                        Height="34"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Command="{Binding CleanupCommand}" />
                <Button Content="查看日志"
                        Style="{StaticResource ActionButton}"
                        MinWidth="0"
                        Height="34"
                        FontSize="12"
                        Command="{Binding ShowLogCommand}" />
            </UniformGrid>

            <!-- ===== 操作目录：勾选的才执行 ===== -->
            <TextBlock Text="操作目录"
                       Style="{StaticResource SectionTitleText}"
                       Margin="2,12,0,8" />

            <ItemsControl ItemsSource="{Binding Targets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Style="{StaticResource AppCheckBox}"
                                  Margin="2,0,0,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
