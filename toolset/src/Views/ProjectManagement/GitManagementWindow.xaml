<Window x:Class="ToolSet.Views.ProjectManagement.GitManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git 版本管理"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <!-- 只读信息值：过长时省略号截断，完整内容放 ToolTip -->
        <Style x:Key="InfoValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource SectionCard}" Margin="10">
        <StackPanel>

            <!-- ===== 卡片头：项目名 ===== -->
            <TextBlock Text="{Binding ProjectName}"
                       Style="{StaticResource CardTitleText}"
                       Margin="0" />

            <Border Height="1"
                    Background="{StaticResource LineBrush}"
                    Margin="0,10,0,10" />

            <!-- ===== 项目信息（只读） ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="检出根目录"
                           Style="{StaticResource FieldLabelText}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CheckoutRootDir}"
                           Style="{StaticResource InfoValueText}" />

                <TextBlock Grid.Row="1"
                           Text="Github"
                           Style="{StaticResource FieldLabelText}" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Github}"
                           Style="{StaticResource InfoValueText}" />
            </Grid>

            <Border Height="1"
                    Background="{StaticResource LineBrush}"
                    Margin="0,2,0,10" />

            <!-- ===== git 操作 ===== -->
            <TextBlock Text="Git 操作"
                       Style="{StaticResource SectionTitleText}" />

            <UniformGrid Rows="1" Columns="3">
                <Button Content="Clone"
                        Style="{StaticResource ActionButton}"
                        MinWidth="0"
                        Height="34"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Command="{Binding CloneCommand}" />
                <Button Content="Pull"
                        Style="{StaticResource ActionButton}"
                        MinWidth="0"
                        Height="34"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Command="{Binding PullCommand}" />
                <Button Content="Push"
                        Style="{StaticResource ActionButton}"
                        MinWidth="0"
                        Height="34"
                        FontSize="12"
                        Command="{Binding PushCommand}" />
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
