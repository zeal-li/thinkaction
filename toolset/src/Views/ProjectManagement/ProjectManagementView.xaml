<UserControl x:Class="ToolSet.Views.ProjectManagement.ProjectManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13">

    <UserControl.Resources>
        <!-- 项目卡片：与环境部署的配置卡片一致的横铺样式 -->
        <Style x:Key="ProjectCard" TargetType="Border" BasedOn="{StaticResource SectionCard}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- ===== 顶部操作区 ===== -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <Button Content="新建项目"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding NewProjectCommand}" />
        </StackPanel>

        <!-- ===== 项目卡片列表 ===== -->
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Projects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProjectCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="1"
                                                Padding="8,2"
                                                CornerRadius="10"
                                                Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="项目配置"
                                                       FontSize="11"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding CreatedAtText}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,6,0,0" />

                                    <Border Height="1"
                                            Background="{StaticResource LineBrush}"
                                            Margin="0,10,0,10" />

                                    <!-- 后续在这里补充项目的配置项 -->
                                    <TextBlock Text="配置项待补充"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态 -->
            <Border VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SectionCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" Margin="0,18">
                    <TextBlock Text="还没有项目"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="点击右上角「新建项目」创建第一个项目。"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
