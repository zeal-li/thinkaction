<UserControl x:Class="ToolSet.Views.ProjectManagement.ProjectManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 项目卡片：与环境部署的配置卡片一致的横铺样式 -->
        <Style x:Key="ProjectCard" TargetType="Border" BasedOn="{StaticResource SectionCard}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- ===== 顶部操作区 ===== -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
            <Button Content="新建项目"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding NewProjectCommand}" />
        </StackPanel>

        <!-- ===== 项目卡片列表 ===== -->
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Projects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProjectCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource CardTitleText}"
                                                   Margin="0"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CreatedAtText}"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="10,0,10,0" />

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="打开目录"
                                                    Style="{StaticResource ActionButton}"
                                                    MinWidth="0"
                                                    Height="26"
                                                    Padding="10,0"
                                                    FontSize="12"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.OpenProjectDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                                            <Button Content="删除项目"
                                                    Style="{StaticResource ActionButton}"
                                                    MinWidth="0"
                                                    Height="26"
                                                    Padding="10,0"
                                                    FontSize="12"
                                                    Margin="8,0,0,0"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1"
                                            Background="{StaticResource LineBrush}"
                                            Margin="0,10,0,10" />

                                    <!-- 项目配置项：检出根目录 / Github / Svn，修改后取消或确认（确认才写回配置） -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="检出根目录"
                                                   Style="{StaticResource FieldLabelText}" />
                                        <TextBox Grid.Column="1"
                                                 Style="{StaticResource AppTextBox}"
                                                 Text="{Binding CheckoutRootDir, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2"
                                                Content="浏览"
                                                Style="{StaticResource ActionButton}"
                                                MinWidth="64"
                                                Margin="8,0,0,0"
                                                Command="{Binding BrowseCheckoutRootDirCommand}" />

                                        <TextBlock Grid.Row="1"
                                                   Text="Github"
                                                   Style="{StaticResource FieldLabelText}" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Style="{StaticResource AppTextBox}"
                                                 Text="{Binding Github, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Github 的版本管理入口：打开 git 操作弹窗 -->
                                        <Button Grid.Row="1"
                                                Grid.Column="2"
                                                Content="版本管理"
                                                Style="{StaticResource ActionButton}"
                                                MinWidth="0"
                                                Height="30"
                                                Padding="12,0"
                                                FontSize="12"
                                                Margin="8,0,0,8"
                                                Command="{Binding OpenGitManagementCommand}" />

                                        <TextBlock Grid.Row="2"
                                                   Text="Svn"
                                                   Style="{StaticResource FieldLabelText}" />
                                        <TextBox Grid.Row="2"
                                                 Grid.Column="1"
                                                 Style="{StaticResource AppTextBox}"
                                                 Text="{Binding Svn, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- Svn 的版本管理入口：打开 svn 操作弹窗 -->
                                        <Button Grid.Row="2"
                                                Grid.Column="2"
                                                Content="版本管理"
                                                Style="{StaticResource ActionButton}"
                                                MinWidth="0"
                                                Height="30"
                                                Padding="12,0"
                                                FontSize="12"
                                                Margin="8,0,0,8"
                                                Command="{Binding OpenSvnManagementCommand}" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,10,0,0"
                                                Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}">
                                        <Button Content="取消"
                                                Style="{StaticResource ActionButton}"
                                                MinWidth="76"
                                                Margin="0,0,8,0"
                                                Command="{Binding CancelEditCommand}" />
                                        <Button Content="确认"
                                                Style="{StaticResource ActionButton}"
                                                MinWidth="76"
                                                Command="{Binding ConfirmEditCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态 -->
            <Border VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SectionCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" Margin="0,18">
                    <TextBlock Text="还没有项目"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="点击「新建项目」创建第一个项目。"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
