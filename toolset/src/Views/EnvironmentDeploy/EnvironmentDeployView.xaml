<UserControl x:Class="ToolSet.Views.EnvironmentDeploy.EnvironmentDeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ===== WSL_SSH_配置 ===== -->
            <Border Style="{StaticResource SectionCard}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="WSL_SSH_配置"
                               Style="{StaticResource CardTitleText}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="hostname" Style="{StaticResource FieldLabelText}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding Wsl.Hostname, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="port" Style="{StaticResource FieldLabelText}" Margin="24,0,10,8" />
                        <TextBox Grid.Row="0" Grid.Column="3"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding Wsl.Port, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="0" Grid.Column="4"
                                Content="测试SSH"
                                Style="{StaticResource ActionButton}"
                                MinWidth="76"
                                Margin="8,0,0,8"
                                Command="{Binding Wsl.TestSshCommand}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="username" Style="{StaticResource FieldLabelText}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding Wsl.Username, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="userkey" Style="{StaticResource FieldLabelText}" Margin="24,0,10,8" />
                        <TextBox Grid.Row="1" Grid.Column="3"
                                 Style="{StaticResource AppTextBox}"
                                 Margin="0,0,0,8"
                                 Text="{Binding Wsl.UserKey, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="1" Grid.Column="4"
                                Content="浏览"
                                Style="{StaticResource ActionButton}"
                                MinWidth="64"
                                Margin="8,0,0,8"
                                Command="{Binding Wsl.BrowseUserKeyCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0"
                                Visibility="{Binding Wsl.HasPendingChanges, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="取消"
                                Style="{StaticResource ActionButton}"
                                MinWidth="76"
                                Margin="0,0,8,0"
                                Command="{Binding Wsl.CancelEditCommand}" />
                        <Button Content="确认"
                                Style="{StaticResource ActionButton}"
                                MinWidth="76"
                                Command="{Binding Wsl.ConfirmEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Centos_SSH_配置 ===== -->
            <Border Style="{StaticResource SectionCard}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Centos_SSH_配置"
                               Style="{StaticResource CardTitleText}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="hostname" Style="{StaticResource FieldLabelText}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding CentOS.Hostname, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="port" Style="{StaticResource FieldLabelText}" Margin="24,0,10,8" />
                        <TextBox Grid.Row="0" Grid.Column="3"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding CentOS.Port, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="0" Grid.Column="4"
                                Content="测试SSH"
                                Style="{StaticResource ActionButton}"
                                MinWidth="76"
                                Margin="8,0,0,8"
                                Command="{Binding CentOS.TestSshCommand}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="username" Style="{StaticResource FieldLabelText}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding CentOS.Username, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="userkey" Style="{StaticResource FieldLabelText}" Margin="24,0,10,8" />
                        <TextBox Grid.Row="1" Grid.Column="3"
                                 Style="{StaticResource AppTextBox}"
                                 Margin="0,0,0,8"
                                 Text="{Binding CentOS.UserKey, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="1" Grid.Column="4"
                                Content="浏览"
                                Style="{StaticResource ActionButton}"
                                MinWidth="64"
                                Margin="8,0,0,8"
                                Command="{Binding CentOS.BrowseUserKeyCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0"
                                Visibility="{Binding CentOS.HasPendingChanges, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="取消"
                                Style="{StaticResource ActionButton}"
                                MinWidth="76"
                                Margin="0,0,8,0"
                                Command="{Binding CentOS.CancelEditCommand}" />
                        <Button Content="确认"
                                Style="{StaticResource ActionButton}"
                                MinWidth="76"
                                Command="{Binding CentOS.ConfirmEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Local_MySql_配置 ===== -->
            <Border Style="{StaticResource SectionCard}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Local_MySql_配置"
                               Style="{StaticResource CardTitleText}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="servicename" Style="{StaticResource FieldLabelText}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding LocalMySql.ServiceName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="dirpath" Style="{StaticResource FieldLabelText}" Margin="24,0,10,8" />
                        <TextBox Grid.Row="0" Grid.Column="3"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding LocalMySql.DirPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="0" Grid.Column="4"
                                Content="浏览"
                                Style="{StaticResource ActionButton}"
                                MinWidth="64"
                                Margin="8,0,0,8"
                                Command="{Binding LocalMySql.BrowseDirPathCommand}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="hostname" Style="{StaticResource FieldLabelText}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding LocalMySql.Hostname, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="port" Style="{StaticResource FieldLabelText}" Margin="24,0,10,8" />
                        <TextBox Grid.Row="1" Grid.Column="3"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding LocalMySql.Port, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="username" Style="{StaticResource FieldLabelText}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding LocalMySql.Username, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="password" Style="{StaticResource FieldLabelText}" Margin="24,0,10,8" />
                        <TextBox Grid.Row="2" Grid.Column="3"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding LocalMySql.Password, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
                                    Orientation="Horizontal">
                            <Button Content="配置服务"
                                    Style="{StaticResource ActionButton}"
                                    MinWidth="76"
                                    Margin="0,0,8,0"
                                    Command="{Binding LocalMySql.ConfigureServiceCommand}" />
                            <Button Content="注册服务"
                                    Style="{StaticResource ActionButton}"
                                    MinWidth="76"
                                    Margin="0,0,8,0"
                                    Command="{Binding LocalMySql.RegisterServiceCommand}" />
                            <Button Content="移除服务"
                                    Style="{StaticResource ActionButton}"
                                    MinWidth="76"
                                    Margin="0,0,8,0"
                                    Command="{Binding LocalMySql.RemoveServiceCommand}" />
                            <Button Content="启动服务"
                                    Style="{StaticResource ActionButton}"
                                    MinWidth="76"
                                    Margin="0,0,8,0"
                                    Command="{Binding LocalMySql.StartServiceCommand}" />
                            <Button Content="停止服务"
                                    Style="{StaticResource ActionButton}"
                                    MinWidth="76"
                                    Margin="0,0,8,0"
                                    Command="{Binding LocalMySql.StopServiceCommand}" />
                            <Button Content="添加用户"
                                    Style="{StaticResource ActionButton}"
                                    MinWidth="76" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0"
                                Visibility="{Binding LocalMySql.HasPendingChanges, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="取消"
                                Style="{StaticResource ActionButton}"
                                MinWidth="76"
                                Margin="0,0,8,0"
                                Command="{Binding LocalMySql.CancelEditCommand}" />
                        <Button Content="确认"
                                Style="{StaticResource ActionButton}"
                                MinWidth="76"
                                Command="{Binding LocalMySql.ConfirmEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
