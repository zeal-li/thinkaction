<Application x:Class="ToolSet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmCommon="clr-namespace:ToolSet.ViewModels.Common"
             xmlns:vmEnv="clr-namespace:ToolSet.ViewModels.EnvironmentDeploy"
             xmlns:viewsCommon="clr-namespace:ToolSet.Views.Common"
             xmlns:viewsEnv="clr-namespace:ToolSet.Views.EnvironmentDeploy">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 模块视图映射：新增模块时在这里登记 ViewModel -> View -->
            <DataTemplate DataType="{x:Type vmCommon:PlaceholderModuleViewModel}">
                <viewsCommon:PlaceholderModuleView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vmEnv:EnvironmentDeployViewModel}">
                <viewsEnv:EnvironmentDeployView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
