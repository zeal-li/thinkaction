<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 最低支持 VS 2022（17.8+）；若要兼容更早的 VS 2022，可改为 net6.0-windows -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>ToolSet</AssemblyName>
    <RootNamespace>ToolSet</RootNamespace>
    <ApplicationIcon>Assets\toolset.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <!-- 允许在只装了更高版本运行时的机器上运行 -->
    <RollForward>LatestMajor</RollForward>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同一份 ico 同时供 exe 图标和窗口图标使用 -->
    <Resource Include="Assets\toolset.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 把 bat 脚本带到输出目录，运行时从 exe 同级的 scripts 目录调用 -->
    <None Include="..\scripts\**\*.*"
          Exclude="..\scripts\tmp\**"
          Link="scripts\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
