<Window x:Class="ToolSet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToolSet"
        Height="740"
        Width="1120"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧模块导航 ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="5,0,5,5">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,22,20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="目录"
                                Style="{StaticResource LinkButton}"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                ToolTip="打开目录"
                                Command="{Binding OpenDirectoryCommand}" />
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource AppComboBox}"
                                  MinWidth="0"
                                  ItemsSource="{Binding Branches}"
                                  SelectedItem="{Binding SelectedBranch}" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Modules}" Margin="10,0,10,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavRadioButton}"
                                         GroupName="ToolModules"
                                         Content="{Binding Title}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ===== 右侧工作区 ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="150" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 模块内容 -->
            <ContentControl Grid.Row="1"
                            Margin="0,5,5,5"
                            Content="{Binding SelectedModule}" />

            <!-- 运行日志 -->
            <Border Grid.Row="0"
                    Margin="0,0,5,0"
                    Style="{StaticResource SectionCard}"
                    Padding="12,10">
                <ListBox x:Name="LogList"
                         Style="{StaticResource LogListBox}"
                         ItemsSource="{Binding Log.Entries}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TimeText}"
                                           Width="62"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding Message}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</Window>
