<Window x:Class="ToolSet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToolSet"
        Icon="Assets/toolset.ico"
        Height="740"
        Width="1120"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧模块导航 ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="5,0,5,5">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,22,20,14">
                    <StackPanel>
                        <ComboBox Style="{StaticResource AppComboBox}"
                                  MinWidth="0"
                                  ItemsSource="{Binding Projects}"
                                  SelectedItem="{Binding SelectedProject}" />
                        <UniformGrid Rows="1" Columns="3" Margin="0,9,0,0">
                            <Button Content="目录"
                                    Style="{StaticResource ActionButton}"
                                    MinWidth="0"
                                    Height="28"
                                    FontSize="12"
                                    Padding="0"
                                    Margin="0,0,6,0"
                                    Command="{Binding OpenDirectoryCommand}" />
                            <Button Content="Git"
                                    Style="{StaticResource ActionButton}"
                                    MinWidth="0"
                                    Height="28"
                                    FontSize="12"
                                    Padding="0"
                                    Margin="0,0,6,0"
                                    Command="{Binding OpenGitManagementCommand}" />
                            <Button Content="Svn"
                                    Style="{StaticResource ActionButton}"
                                    MinWidth="0"
                                    Height="28"
                                    FontSize="12"
                                    Padding="0"
                                    Command="{Binding OpenSvnManagementCommand}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Modules}" Margin="10,0,10,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavRadioButton}"
                                         GroupName="ToolModules"
                                         Content="{Binding Title}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ===== 右侧工作区 ===== -->
        <Grid Grid.Column="1">
            <!-- 模块内容 -->
            <ContentControl Margin="0,5,5,5"
                            Content="{Binding SelectedModule}" />
        </Grid>
    </Grid>
</Window>
